    "diff": "@@ -3,7 +3,8 @@\n   Player ship: a wooden two-masted brig. Oak hull with a raised stern castle (lit brass lanterns),\n   forecastle, bowsprit. Square sails braced to catch the wind on both masts, a jib to the bowsprit,\n   red pennants. Top-down 3/4 view, no water (it sits on a moving sea). 16 headings so it turns\n-  smoothly; the pennants flutter in the \"sail\" animation.\n+  smoothly; the pennants flutter in the \"sail\" animation. Team colours for 4 players (red, blue,\n+  green, gold) on the pennants, gunwales and the hull stripe.\n size: [92, 70]\n pivot: [46, 46]\n origin: [32, 0, 0]          # the hull's centre at the waterline lands on the pivot\n@@ -16,26 +17,27 @@\n materials:\n   hull: { keys: [\"3\", \"4\", \"5\", \"7\"] }\n   deck: { keys: [\"4\", \"5\", \"6\"] }\n-  rail: { keys: [\"1\", \"2\"] }\n+  rail: { keys: [\"g\", \"h\"] }                 # team colour: painted gunwales\n+  tar:  { keys: [\"1\", \"2\"] }                 # gun ports, hatch\n   mast: { keys: [\"1\", \"2\", \"4\"] }\n   lamp: { keys: [\"e\"] }                       # one key = unshaded: lanterns glow\n-  trim: { ramp: gold }\n+  trim: { ramp: red }                        # team colour\n   sail: { keys: [\"8\", \"9\", \"a\", \"b\"], two_sided: true }\n-  flag: { ramp: red }\n+  flag: { ramp: red }                        # team colour\n \n parts:\n   - hull: { from: [0, 0, 0], length: 64, beam: 19, height: 7, bow: 0.4, stern: 0.1, material: hull, top: deck, rim: rail }\n   - box: { from: [0, -6, 7], to: [12, 6, 10], material: hull, top: deck, rim: rail }      # stern castle\n   - box: { from: [51, -5, 7], to: [56, 5, 8], material: hull, top: deck, rim: rail }       # forecastle\n-  - box: { from: [1, -9, 3], to: [50, -9, 3], material: trim }                             # gold stripe\n+  - box: { from: [1, -9, 3], to: [50, -9, 3], material: trim }                             # team stripe\n     mirror: true\n-  - box: { from: [16, -9, 5], to: [17, -9, 6], material: rai