---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Translate from "../components/Translate.astro";
import Demo from "../components/Demo.astro";
import Orchestrator from "../components/Orchestrator.astro";
import Features from "../components/Features.astro";
import Compare from "../components/Compare.astro";
import Install from "../components/Install.astro";
import OpenSource from "../components/OpenSource.astro";
import Gallery from "../components/Gallery.astro";
import Faq from "../components/Faq.astro";
---

<Base
  title="PAGAN: pixel art in a language your AI agent speaks"
  description="PAGAN is a free, open-source language for game art. Your AI agent writes it; PAGAN lints and renders it into consistent sprites, 3D-rendered headings, glTF meshes for 3D games, animations and Godot-ready assets."
>
  <Hero />
  <Translate />
  <Demo />
  <Orchestrator />
  <Features />
  <Compare />
  <Install />
  <OpenSource />
  <Gallery />
  <Faq />
</Base>
